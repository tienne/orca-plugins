{
  "name": "git-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugins/git-tools/src",
  "projectType": "application",
  "tags": [
    "type:plugin",
    "scope:git"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/plugins/git-tools"
      ],
      "options": {
        "command": "node scripts/build-plugin.mjs git-tools"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p plugins/git-tools/tsconfig.json"
      }
    },
    "validate-plugin": {
      "executor": "nx:run-commands",
      "options": {
        "command": "orca plugin validate dist/plugins/git-tools --json"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "vite --config plugins/git-tools/vite.config.ts"
      }
    }
  }
}
