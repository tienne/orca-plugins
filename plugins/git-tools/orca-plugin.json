{
  "manifestVersion": 2,
  "id": "git-tools",
  "name": "Git Logs",
  "version": "0.1.0",
  "description": "Local Git commit graph, confirmed commit actions and a read-only side-by-side diff viewer.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "git-tools",
        "title": "Git Logs",
        "icon": "branch",
        "entry": "ui/index.html"
      }
    ],
    "customEditors": [
      {
        "id": "git-diff",
        "title": "Git Diff",
        "extensions": [".orcadiff"],
        "entry": "ui/editor.html",
        "priority": "default",
        "frame": "isolated"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    }
  ],
  "license": "MIT",
  "main": "worker.js"
}
