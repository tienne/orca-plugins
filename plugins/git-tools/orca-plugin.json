{
  "manifestVersion": 2,
  "id": "git-tools",
  "name": "Git Tools",
  "version": "0.1.0",
  "description": "Git graph and diff viewer for Orca. Initial development scaffold.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "git-tools",
        "title": "Git Tools",
        "icon": "branch",
        "entry": "ui/index.html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ],
  "license": "MIT",
  "main": "worker.js"
}
