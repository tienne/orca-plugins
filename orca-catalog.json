{
  "catalogVersion": 2,
  "name": "Tienne Orca Plugins",
  "owner": "tienne",
  "plugins": [
    {
      "id": "tienne.git-logs",
      "source": {
        "kind": "git",
        "url": "https://github.com/tienne/orca-plugins.git",
        "ref": "release",
        "path": "plugins/git-logs"
      },
      "description": "Explore Git logs in a visual Git tree and commit graph. Compare changes in a read-only side-by-side diff and run confirmed Git actions in Orca.",
      "categories": [
        "developer-tools"
      ],
      "releases": [
        {
          "version": "0.1.1",
          "commit": "b7d303a14947f70939b4f6386a900585037a6ce9",
          "contentHash": "f094749f2d72c38625a1ca2e74f3bc331727fa6622945408b60202ab79cd6592",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Git Logs",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Logs"
            },
            {
              "kind": "events",
              "name": "workspace.created"
            },
            {
              "kind": "events",
              "name": "workspace.changed"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".orcadiff"
            }
          ],
          "capabilities": [
            "workspace:read",
            "workspace:write"
          ],
          "fileTypes": [
            "orcadiff"
          ],
          "editorFileTypes": [
            "orcadiff"
          ]
        },
        {
          "version": "0.1.0",
          "commit": "c06f01b7c62909b4f8752e1e91a2f182b3dfd97e",
