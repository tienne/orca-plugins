          "minimumOrca": "1.4.248",
          "name": "Git Logs",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Logs"
            },
            {
              "kind": "events",
              "name": "workspace.created"
            },
            {
              "kind": "events",
              "name": "workspace.changed"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".orcadiff"
            }
          ],
          "capabilities": [
            "workspace:read",
            "workspace:write"
          ],
