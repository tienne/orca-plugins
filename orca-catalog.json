      "id": "tienne.git-logs",
      "source": {
        "kind": "git",
        "url": "https://github.com/tienne/orca-plugins.git",
        "ref": "release",
        "path": "plugins/git-logs"
      },
      "description": "Explore Git logs in a visual Git tree and commit graph. Compare changes in a read-only side-by-side diff and run confirmed Git actions in Orca.",
      "categories": [
        "developer-tools"
      ],
      "releases": [
        {
          "version": "0.2.0",
          "commit": "df81752205f9fb8091093aa562973bb1d3c61dd6",
          "contentHash": "4f23fa98633181d0718d937d76cff9b910a1a5117af0e617a35409f91923c7f0",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Git Logs",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Logs"
            },
            {
              "kind": "events",
              "name": "workspace.created"
            },
            {
              "kind": "events",
              "name": "workspace.changed"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".orcadiff"
            }
          ],
